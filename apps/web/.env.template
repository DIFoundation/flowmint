# Default environment variables for generated Celo projects
# Public Celo RPC (mainnet)
CELO_RPC_URL=https://forno.celo.org


# RainbowKit Wallet Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# M6 usage metrics dashboard (GET /api/metrics). Not a real auth system —
# just enough to keep wallet addresses and usage data from being wide
# open on a public URL by default. Required in production.
METRICS_ACCESS_KEY=
